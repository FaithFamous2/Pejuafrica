# PejuAfrica API
APP_NAME=PejuAfrica
APP_ENV=development
DEBUG=true
# Set true only when debugging SQL (startup create_all is very noisy)
SQL_ECHO=false
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (system of record)
DATABASE_URL=postgresql+asyncpg://peju:peju_dev_password@localhost:5432/pejuafrica
DATABASE_URL_SYNC=postgresql://peju:peju_dev_password@localhost:5432/pejuafrica

# Turso / libSQL (tenant operational store: activity + feature flags)
# Leave empty in local dev to use embedded SQLite fallback at ./data/turso_local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend URL (email links, CORS)
FRONTEND_URL=http://localhost:3000

# Super admin bootstrap (created on first startup if no super admin exists)
BOOTSTRAP_SUPERADMIN_EMAIL=admin@pejuafrica.com
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMeNow!123
BOOTSTRAP_SUPERADMIN_NAME=Peju Super Admin

# Payment webhooks (optional in development)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# LLM (optional — falls back to local templates)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=auto

# Rate limits
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GENERATE_PER_HOUR=10

# Cloudinary (optional env fallback — prefer Super Admin → Media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=pejuafrica
