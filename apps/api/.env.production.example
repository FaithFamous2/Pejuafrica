# PejuAfrica API — production / Render testing template
# Paste these into Render → Environment (do not commit real secrets)

APP_NAME=PejuAfrica
APP_ENV=production
DEBUG=false
SQL_ECHO=false
API_V1_PREFIX=/api/v1

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookies: secure + host-only (empty domain) so Vercel rewrite cookies work
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Your Vercel URL (no trailing slash). JSON array for CORS.
FRONTEND_URL=https://YOUR-APP.vercel.app
CORS_ORIGINS=["https://YOUR-APP.vercel.app"]

# Neon — convert the pooled connection string:
# async:  postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require
# sync:   postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?ssl=require
DATABASE_URL_SYNC=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Upstash Redis (TLS URL from console — optional for MVP; rate limits are in-memory today)
REDIS_URL=rediss://default:TOKEN@xxx.upstash.io:6379
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Turso optional — leave empty to use SQLite file on Render disk (ephemeral on free tier)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

BOOTSTRAP_SUPERADMIN_EMAIL=admin@pejuafrica.com
BOOTSTRAP_SUPERADMIN_PASSWORD=REPLACE_STRONG_PASSWORD
BOOTSTRAP_SUPERADMIN_NAME=Peju Super Admin

OPENAI_API_KEY=
LLM_PROVIDER=auto

RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GENERATE_PER_HOUR=10

# Prefer Super Admin → Media for Cloudinary; env fallbacks OK for smoke tests
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=pejuafrica
